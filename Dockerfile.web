# Node 22: the vanilla-extract build tooling needs Node 20.19+ or 22.12+
FROM node:22-alpine AS build
RUN npm install -g pnpm@8.6.9

WORKDIR /app
# Copy only the web app, not the scraper: pnpm would otherwise install the
# scraper's dev dependencies too, like better-sqlite3, which has no prebuilt
# binary for this Node version and can't compile without Python. Manifests
# first, so the install layer is cached while only source files change.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages/web-ui/package.json packages/web-ui/
RUN pnpm install --frozen-lockfile
COPY packages/web-ui packages/web-ui
# The build doesn't touch the database, so it needs no Supabase credentials.
# At runtime they come from Fly secrets.
RUN pnpm --filter web-ui build

# Only the standalone server and its traced dependencies go into the final
# image, not the whole workspace's node_modules.
FROM node:22-alpine
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME=0.0.0.0

# Owned by the runtime user so Next can write to .next/cache
COPY --from=build --chown=node:node /app/packages/web-ui/.next/standalone ./
COPY --from=build --chown=node:node /app/packages/web-ui/.next/static ./packages/web-ui/.next/static

USER node
EXPOSE 8080

CMD ["node", "packages/web-ui/server.js"]
